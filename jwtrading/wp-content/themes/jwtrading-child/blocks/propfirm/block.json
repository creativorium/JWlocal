{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jwt/propfirm",
	"title": "JWT Partner Section",
	"category": "jwtrading",
	"icon": "list-view",
	"description": "Satu section partner (prop firm / broker / tools) berisi kartu-kartu dengan kode diskon dan video guide.",
	"textdomain": "jwtrading",
	"editorScript": "jwt-blocks-editor",
	"render": "file:./render.php",
	"supports": {
		"align": [ "full" ],
		"html": false,
		"anchor": true
