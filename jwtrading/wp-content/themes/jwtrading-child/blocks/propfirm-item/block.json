{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jwt/propfirm-item",
	"title": "JWT Partner Card",
	"category": "jwtrading",
	"icon": "building",
	"description": "Satu partner: nama, blurb, kode diskon (klik untuk copy), dan video guide-nya.",
	"textdomain": "jwtrading",
	"parent": [ "jwt/propfirm" ],
	"editorScript": "jwt-blocks-editor",
	"render": "file:./render.php",
	"supports": {
		"html": false,
		"reusable": false
	},
	"attributes": {
		"name": { "type": "string", "default": "" },
		"blurb": { "type": "string", "default": "" },
		"url": { "type": "string", "default": "" },
		"variant": { "type": "string", "default": "default" },
		"code": { "type": "string", "default": "" },
		"codeLabel": { "type": "string", "default": "Use Code" },
		"guideLabel": { "type": "string", "default": "" },
		"guideVideoUrl": { "type": "string", "default": "" },
		"guidePosterId": { "type": "number", "default": 0 },
		"guidePosterUrl": { "type": "string", "default": "" }
	}
}
